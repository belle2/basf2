# EventType: 1110022008
# Descriptor: [B0 -> [K*0 -> K+ pi-] [pi0 -> gamma gamma]]cc
# NickName: Bd_Kst0pi0
# Documentation: B0 -> K*0 pi0 signal MC with K*0 -> K+ pi- and pi0 -> gamma gamma.
# Tested: YES
# PhysicsWG: BHadronic
# Responsible: Mamunur Rashid
# Email: rashidmr@mail.uc.edu
# Cuts: None
# Date: 20261023

Alias K*0sig K*0
Alias anti-K*0sig anti-K*0
ChargeConj K*0sig anti-K*0sig
Alias pi0sig pi0

Decay Upsilon(4S)
1.0   B0sig anti-B0sig B0 anti-B0   VSS_BMIX dm;
Enddecay

Decay B0sig
1.0   K*0sig pi0sig   SVS;
Enddecay
CDecay anti-B0sig

Decay K*0sig
1.0   K+ pi-   VSS;
Enddecay
CDecay anti-K*0sig

Decay pi0sig
1.0   gamma gamma   PHSP;
Enddecay

End
