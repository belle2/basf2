# EventType: 1110028002
# Descriptor: [B0 -> [K*0 -> K+ pi-] [eta -> gamma gamma]]cc
# NickName: Bd_Kst0eta,gg
# Documentation: B0 -> K*0 eta signal MC with K*0 -> K+ pi- and eta -> gamma gamma.
# Tested: YES
# PhysicsWG: BHadronic
# Responsible: Mamunur Rashid
# Email: rashidmr@mail.uc.edu
# Cuts: None
# Date: 20261023

Alias K*0sig K*0
Alias anti-K*0sig anti-K*0
ChargeConj K*0sig anti-K*0sig
Alias etasig eta

Decay Upsilon(4S)
1.0   B0sig anti-B0sig B0 anti-B0   VSS_BMIX dm;
Enddecay

Decay B0sig
1.0   K*0sig etasig   SVS;
Enddecay
CDecay anti-B0sig

Decay K*0sig
1.0   K+ pi-   VSS;
Enddecay
CDecay anti-K*0sig

Decay etasig
1.0   gamma gamma   PHSP;
Enddecay

End
