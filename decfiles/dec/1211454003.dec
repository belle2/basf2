# EventType: 1211454003
# Descriptor: [B+ -> J/psi [-> mu+ mu-] pi0 [-> gamma gamma] omega [-> pi+ pi- pi0 [-> gamma gamma]] K+]
# NickName: Bu_Jpsipi0omegaKp_mumu
# Documentation: B -> charmonium decays.
# Tested: Yes
# PhysicsWG: Quarkonium
# Responsible: Kirill Chilikin
# Email: K.A.Chilikin@inp.nsk.su
# Cuts: None
# Date: 20260717
#
# This decay model is intended for phase-space-dependent efficiency
# determination. All exclusive decays have the PHSP distributuion.
# Do not use it for one-dimensional analyses without proper reweighting.

Alias pi0sig pi0
Alias omegasig omega

Decay Upsilon(4S)
0.5 B+sig B- VSS;
0.5 B-sig B+ VSS;
Enddecay

Decay B+sig
1.0 J/psisig pi0sig omegasig K+ PHOTOS PHSP;
Enddecay

CDecay B-sig

Decay J/psisig
1.0 mu+ mu- PHOTOS PHSP;
Enddecay

Decay pi0sig
1.0 gamma gamma PHSP;
Enddecay

Decay omegasig
1.0 pi+ pi- pi0sig PHOTOS PHSP;
Enddecay

End
