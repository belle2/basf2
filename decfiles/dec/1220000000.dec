
# EventType: 1220000000
# Descriptor: [B+ -> eta' K*+]       
# NickName: Bu_etapKst
# Documentation:    Decay mode for hadronic decay  
# Tested: Yes
# Responsible: Chihhan Tseng
# Email: chihan@post.kek.jp
# PhysicsWG: BHadronic 
# Cuts: None
# Date: 09/17/2026

# Upsilon(4S) decay
Decay Upsilon(4S)
0.5 B+sig B-   VSS;
0.5 B+    B-sig VSS;
Enddecay

Decay B+sig
1.0 Kst+   Etap      PHOTOS SVS;
Enddecay
CDecay B-sig

End
