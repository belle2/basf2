# EventType: 1260000003
# Descriptor: [B+ -> K*+ nu anti-nu]cc
# NickName: Bu_Kstarnunubar
# Documentation: Rare b->s nu anti-nu process, decays to only reconstructed final states
# Tested: Yes
# PhysicsWG: EWP
# Responsible: Giulio Dujany
# Email: giulio.dujany@iphc.cnrs.fr
# Cuts: None
# Date: 20260715

Alias MyK*+ K*+
Alias MyK*- K*-
ChargeConj MyK*+ MyK*-
Alias K_S0sig K_S0
Alias pi0sig pi0

Decay Upsilon(4S)
0.5 B+sig B-         VSS;
0.5 B-sig B+         VSS;
Enddecay

Decay B+sig
1.0 MyK*+ nu_e anti-nu_e                    PHOTOS KSTARNUNU_REV;
Enddecay
CDecay B-sig

Decay MyK*+
0.5      K+  pi0sig                        VSS;
0.5      K_S0sig  pi+                        VSS;
Enddecay
CDecay MyK*-

Decay K_S0sig
1.0    pi- pi+ PHSP;
Enddecay

Decay pi0sig
1.0 gamma gamma PHSP;
Enddecay

End

