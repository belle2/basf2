# Pythia default config file: basf2/data/generators/modules/fragmentation/pythia_belle2_charm.dat

Decay vpho
1.000 c anti-c              PYTHIA 91;
Enddecay

Alias MyD0 D0
Alias Mypi0 pi0

Decay D*+
1.000 MyD0  pi+     VSS;
Enddecay

Decay MyD0
1.000 pi+ pi- Mypi0 Mypi0       D0Topippim2pi0;
Enddecay

Decay Mypi0
1.000 gamma gamma           PHSP;
Enddecay

End
