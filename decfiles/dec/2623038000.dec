# Pythia default config file: basf2/data/generators/modules/fragmentation/pythia_belle2_charm.dat

Alias MyD0 D0
Alias Myeta eta

Decay vpho
1.000 c    anti-c      PYTHIA 91;
Enddecay

Decay D*+
1.000 MyD0  pi+     VSS;
Enddecay

Decay MyD0
1.000 pi+ pi- Myeta   D0TopipiEta;
Enddecay

Decay Myeta
1.000 gamma gamma    PHSP;
Enddecay

End

