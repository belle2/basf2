# EventType: 2896852170
# Descriptor: [e+ e- -> J/psi [-> l+ l-] X->[D*+ (tag) D*- (miss)]]
# NickName: ee_Jpsi_DstDst
# Documentation: Double charmonium production.
# Tested: 
# PhysicsWG: Quarkonium
# Responsible: Jiyuan Zhang
# Email: jiyuanzhang24@m.fudan.edu.cn
# Cuts: None
# Date: 20261010

Alias Myjpsi J/psi
Alias myD*+ D*+
Alias myD*- D*-

Alias myD0  D0
Alias myantiD0  anti-D0

ChargeConj myD*+ myD*-
ChargeConj myD0 myantiD0

Decay vpho
1.00  Myjpsi  X4160    PHSP;
Enddecay

Decay X4160
0.5 myD*+ D*-    PHSP;
0.5 D*+ myD*-    PHSP;
Enddecay

Decay Myjpsi
0.5   e+ e-              PHOTOS VLL;
0.5   mu+ mu-            PHOTOS VLL;
Enddecay

Decay myD*+
1.00  myD0  pi+          PHOTOS PHSP;
Enddecay
CDecay myD*-

Decay myD0
0.03945    K-    pi+            PHSP;
0.02860    K_S0  pi+  pi-       D_DALITZ;
0.14400    pi+  K-   pi0        D_DALITZ;
0.00408    K-  K+               PHSP;
0.08220    K-  pi+  pi+  pi-    PHSP;
Enddecay
CDecay myantiD0

Decay K_S0
1.000  pi+   pi-         PHSP;
Enddecay

Decay pi0
1.00   gamma  gamma      PHSP;
Enddecay

End

