# missing_resonances.dec - supplementary EvtGen decay modes for Herwig fragmentation
#
# Herwig 7's cluster hadronisation model produces hadronic resonances that are
# absent from basf2's particle data tables (evt.pdl) or present but lacking
# decay modes in DECAY_BELLE2.DEC.  This file provides PHSP decay modes for
# both categories so EvtGen can decay them before Geant4 sees them.
#
# This file is loaded as UserDecFile after DECAY_BELLE2.DEC.
#
# Category 1: particles absent from evt.pdl.
#             These also require pdg.add_particle() calls before b2.process().
#             Without that registration EvtGen cannot parse this file and aborts
#             at job startup with "Unknown particle name".  The required calls
#             are made automatically by add_herwig_continuum_generator() (in
#             generators/scripts/herwig.py) via _register_herwig_particles(),
#             which is called unconditionally before Stage 1 runs.  
# Category 2: particles in evt.pdl with no DECAY_BELLE2.DEC modes - no
#             pdg.add_particle() needed; only the Decay blocks below are required.
#
# Branching ratios are taken from Herwig's baryon_decays.in and meson_decays.in.
# PHSP is used throughout.  All modes are preliminary pending review
# and integration into DECAY_BELLE2.DEC.  Once these modes are accepted/merged
# in DECAY_BELLE2.DEC, the corresponding blocks here are to be removed; stale entries here 
# silently override DECAY_BELLE2.DEC.


# =============================================================================
# Category 1 - absent from evt.pdl
# =============================================================================

# -----------------------------------------------------------------------------
# Mesons
# -----------------------------------------------------------------------------

# kappa / K0*(700)  PDG ±9000321 (+), 9000311 (0)  mass=0.841 GeV  width=0.618 GeV  J=0
# I=1/2 scalar partner of sigma_0(500).

Decay kappa+
  0.666667  K0       pi+                                  PHSP;
  0.333333  K+       pi0                                  PHSP;
Enddecay
CDecay anti-kappa+

Decay kappa0
  0.666667  K+       pi-                                  PHSP;
  0.333333  K0       pi0                                  PHSP;
Enddecay
CDecay anti-kappa0


# K' scalar kaons  PDG ±100321 (+), 100311 (0)  mass=1.460 GeV  width=0.260 GeV  J=0
# Distinct from K'*+ (PDG 100323, vector J=1) which is already in evt.pdl.

Decay K'+
  0.300000  K_0*0    pi+                                  PHSP;
  0.279487  K*0      pi+                                  PHSP;
  0.150000  K_0*+    pi0                                  PHSP;
  0.139744  K*+      pi0                                  PHSP;
  0.087179  K0       rho+                                 PHSP;
  0.043590  K+       rho0                                 PHSP;
Enddecay
CDecay anti-K'+

Decay K'0
  0.300000  K_0*+    pi-                                  PHSP;
  0.279487  K*+      pi-                                  PHSP;
  0.150000  K_0*0    pi0                                  PHSP;
  0.139744  K*0      pi0                                  PHSP;
  0.087179  K+       rho-                                 PHSP;
  0.043590  K0       rho0                                 PHSP;
Enddecay
CDecay anti-K'0


# eta'_2 = eta2(1870)  PDG 10335  mass=1.842 GeV  width=0.225 GeV  J=2  self-conjugate

Decay eta'_2
  0.278395  a_2-     pi+                                  PHSP;
  0.278395  a_20     pi0                                  PHSP;
  0.278395  a_2+     pi-                                  PHSP;
  0.139195  f_2      eta                                  PHSP;
  0.008540  a_0-     pi+                                  PHSP;
  0.008540  a_00     pi0                                  PHSP;
  0.008540  a_0+     pi-                                  PHSP;
Enddecay


# chi_c2(2P) = chi_c2(3930)  PDG 100445  mass=3.929 GeV  width=0.029 GeV  J=2  self-conjugate

Decay chi_c2(2P)
  0.529100  D0       anti-D0                              PHSP;
  0.470900  D+       D-                                   PHSP;
Enddecay


# -----------------------------------------------------------------------------
# Baryons
# -----------------------------------------------------------------------------

# N(1440) Roper resonances  PDG 12112 (0), ±12212 (+)  mass=1.440 GeV  width=0.300 GeV  J=1/2

Decay N(1440)0
  0.433245  p+       pi-           PHSP;
  0.216622  n0       pi0           PHSP;
  0.131223  Delta-   pi+           PHSP;
  0.087482  Delta0   pi0           PHSP;
  0.058321  n0       pi+  pi-      PHSP;
  0.043741  Delta+   pi-           PHSP;
  0.029161  n0       pi0  pi0      PHSP;
  0.000205  n0       gamma         PHSP;
Enddecay
CDecay anti-N(1440)0

Decay N(1440)+
  0.433153  n0       pi+           PHSP;
  0.216576  p+       pi0           PHSP;
  0.131196  Delta++  pi-           PHSP;
  0.087464  Delta+   pi0           PHSP;
  0.058309  p+       pi+  pi-      PHSP;
  0.043732  Delta0   pi+           PHSP;
  0.029155  p+       pi0  pi0      PHSP;
  0.000415  p+       gamma         PHSP;
Enddecay
CDecay anti-N(1440)+


# N(1520)  PDG 1214 (0), ±2124 (+)  mass=1.520 GeV  width=0.120 GeV  J=3/2
# Herwig uses non-standard PDG codes 1214/2124 (standard 2116/2216 not in evt.pdl).

Decay N(1520)0
  0.380000  p+       pi-                                  PHSP;
  0.190000  n0       pi0                                  PHSP;
  0.125000  Delta-   pi+                                  PHSP;
  0.115700  p+       rho-                                 PHSP;
  0.083333  Delta0   pi0                                  PHSP;
  0.057850  n0       rho0                                 PHSP;
  0.041667  Delta+   pi-                                  PHSP;
  0.004150  n0       gamma                                PHSP;
  0.002300  n0       eta                                  PHSP;
Enddecay
CDecay anti-N(1520)0

Decay N(1520)+
  0.380000  n0       pi+                                  PHSP;
  0.190000  p+       pi0                                  PHSP;
  0.125000  Delta++  pi-                                  PHSP;
  0.115067  n0       rho+                                 PHSP;
  0.083333  Delta+   pi0                                  PHSP;
  0.057533  p+       rho0                                 PHSP;
  0.041667  Delta0   pi+                                  PHSP;
  0.005100  p+       gamma                                PHSP;
  0.002300  p+       eta                                  PHSP;
Enddecay
CDecay anti-N(1520)+


# N(1535)  PDG 22112 (0), ±22212 (+)  mass=1.535 GeV  width=0.150 GeV  J=1/2

Decay N(1535)0
  0.300000  n0       pi0                                  PHSP;
  0.300000  p+       pi-                                  PHSP;
  0.380000  n0       eta                                  PHSP;
  0.020000  N(1440)0 pi0                                  PHSP;
Enddecay
CDecay anti-N(1535)0

Decay N(1535)+
  0.300000  p+       pi0                                  PHSP;
  0.300000  n0       pi+                                  PHSP;
  0.380000  p+       eta                                  PHSP;
  0.020000  N(1440)+ pi0                                  PHSP;
Enddecay
CDecay anti-N(1535)+


# Sigma(1660) charged states  PDG ±13112 (-), ±13222 (+)  mass=1.660 GeV  width=0.100 GeV  J=1/2  S=-1
# Neutral PDG 13212 is in evt.pdl with DECAY_BELLE2.DEC modes.

Decay Sigma(1660)-
  0.445000  Lambda0  pi-                                  PHSP;
  0.222500  Sigma-   pi0                                  PHSP;
  0.222500  Sigma0   pi-                                  PHSP;
  0.110000  n0       K-                                   PHSP;
Enddecay
CDecay anti-Sigma(1660)-

Decay Sigma(1660)+
  0.445000  Lambda0  pi+                                  PHSP;
  0.222500  Sigma0   pi+                                  PHSP;
  0.222500  Sigma+   pi0                                  PHSP;
  0.110000  p+       anti-K0                              PHSP;
Enddecay
CDecay anti-Sigma(1660)+


# Sigma(1670) charged states  PDG ±13114 (-), ±13224 (+)  mass=1.670 GeV  width=0.060 GeV  J=3/2  S=-1
# Neutral PDG 13214 is in evt.pdl with DECAY_BELLE2.DEC modes.

Decay Sigma(1670)-
  0.358000  Sigma-   pi0                                  PHSP;
  0.358000  Sigma0   pi-                                  PHSP;
  0.179000  Lambda0  pi-                                  PHSP;
  0.105000  n0       K-                                   PHSP;
Enddecay
CDecay anti-Sigma(1670)-

Decay Sigma(1670)+
  0.358000  Sigma0   pi+                                  PHSP;
  0.358000  Sigma+   pi0                                  PHSP;
  0.179000  Lambda0  pi+                                  PHSP;
  0.105000  p+       anti-K0                              PHSP;
Enddecay
CDecay anti-Sigma(1670)+


# Sigma(1750) charged states  PDG ±23112 (-), ±23222 (+)  mass=1.750 GeV  width=0.090 GeV  J=1/2  S=-1
# Absent from evt.pdl. Neutral PDG 23212 is Category 2 (in evt.pdl, no modes); see below.

Decay Sigma(1750)-
  0.550000  Sigma-   eta                                  PHSP;
  0.200000  Lambda0  pi-                                  PHSP;
  0.250000  n0       K-                                   PHSP;
Enddecay
CDecay anti-Sigma(1750)-

Decay Sigma(1750)+
  0.550000  Sigma+   eta                                  PHSP;
  0.200000  Lambda0  pi+                                  PHSP;
  0.250000  p+       anti-K0                              PHSP;
Enddecay
CDecay anti-Sigma(1750)+


# Xi(1690)  PDG ±13312 (-), 13322 (0)  mass=1.690 GeV  width=0.010 GeV  J=1/2  S=-2

Decay Xi(1690)-
  0.571429  Lambda0  K-                                   PHSP;
  0.285714  Sigma-   anti-K0                              PHSP;
