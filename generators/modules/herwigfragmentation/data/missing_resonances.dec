# Xi(1820)  PDG ±13314 (-), 13324 (0)  mass=1.823 GeV  width=0.024 GeV  J=3/2  S=-2
# Xi*0 = Xi(1530)0 PDG 3324;  Xi*- = Xi(1530)- PDG 3314.

Decay Xi(1820)-
  0.550000  Lambda0  K-                                   PHSP;
  0.140000  Xi*0     pi-                                  PHSP;
  0.086667  Sigma-   anti-K0                              PHSP;
  0.073333  Xi0      pi-                                  PHSP;
  0.070000  Xi*-     pi0                                  PHSP;
  0.043333  Sigma0   K-                                   PHSP;
  0.036667  Xi-      pi0                                  PHSP;
Enddecay
CDecay anti-Xi(1820)-

Decay Xi(1820)0
  0.550000  Lambda0  anti-K0                              PHSP;
  0.140000  Xi*-     pi+                                  PHSP;
  0.086667  Sigma+   K-                                   PHSP;
  0.073333  Xi-      pi+                                  PHSP;
  0.070000  Xi*0     pi0                                  PHSP;
  0.043333  Sigma0   anti-K0                              PHSP;
  0.036667  Xi0      pi0                                  PHSP;
Enddecay
CDecay anti-Xi(1820)0


# Xi(1950)  PDG ±23312 (-), 23322 (0)  mass=1.959 GeV  width=0.060 GeV  J=1/2  S=-2

Decay Xi(1950)-
