#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# This script checks if the standard reconstruction runs without
# error for at least a few events

import basf2
from simulation import add_simulation
from geometry import get_components

basf2.set_random_seed(12345)

exp_number = 2003
path = basf2.create_path()
path.add_module("EventInfoSetter", evtNumList=[10], expList=[exp_number])
path.add_module("EvtGenInput")
add_simulation(path, components=get_components(exp_number), useVTX=True)
path.add_module('RootOutput', outputFileName='evtgen_upgrade_bbar.root')

basf2.process(path)
